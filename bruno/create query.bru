meta {
  name: create query
  type: http
  seq: 27
}

post {
  url: {{host}}/projects/{{projectId}}/queries
  body: text
  auth: inherit
}

headers {
  Content-Type: application/json
}

body:text {
  {
      "select" : [ "@id", "@type" ],
      "@type" : "Query",
      "where" : {
          "@type" : "CompositeConstraint",
          "constraint" : [ 
              {"@type": "PrimitiveConstraint", "inverse": false, "operator": "=", "property": "owningRelatedElement", "value": [{
                      "@id": "c2387c83-5774-4342-921a-729064d959ab"
              }]}, 
              {"@type": "PrimitiveConstraint", "inverse": false, "operator": "=", "property": "@type", "value": ["NamespaceImport"]}
          ],
          "operator" : "or"
      }
  }
}

vars:post-response {
  queryId: res('@id')
}

settings {
  encodeUrl: true
}
