meta {
  name: update query
  type: http
  seq: 31
}

put {
  url: {{host}}/projects/{{projectId}}/queries/{{queryId}}
  body: text
  auth: inherit
}

headers {
  Content-Type: application/json
}

body:text {
  {
      "select" : [ "@id", "@type" ],
      "@type" : "Query",
      "where" : {
          "@type": "PrimitiveConstraint", 
          "inverse": false, 
          "operator": "=", 
          "property": "name", 
          "value": "1c-Parts Tree Redefinition"
      }
  }
}

settings {
  encodeUrl: true
}
