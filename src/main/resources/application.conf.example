ktor {
  deployment {
    environment = development
    port = 8080
    autoreload = true
    watch = [ org.openmbee.flexo.sysmlv2 ]
  }

  application {
    modules = [ org.openmbee.flexo.sysmlv2.AppMainKt.module ]
  }
}

flexo {
    protocol = "http"
    protocol = ${?FLEXO_PROTOCOL}
    host = "localhost"
    host = ${?FLEXO_HOST}
    port = "8080"
    port = ${?FLEXO_PORT}
    org = "sysmlv2"
    org = ${?FLEXO_SYSMLV2_ORG}
    # timeout in seconds
    defaultTimeout = "1800"
    defaultTimeout = ${?FLEXO_DEFAULT_TIMEOUT}
    auth = ""
    auth = ${?FLEXO_AUTH}
    basePath = ""
    basePath = ${?BASEPATH}
    # space-separated origins allowed for CORS, e.g. "https://app.example.org http://localhost:3000";
    # only these origins may make credentialed (Authorization) cross-origin requests.
    # empty (the default) sends no CORS headers at all, so browsers refuse every
    # cross-origin request; same-origin and non-browser clients are unaffected
    corsAllowedOrigins = ""
    corsAllowedOrigins = ${?FLEXO_CORS_ALLOWED_ORIGINS}
}
